# Kommo integration configuration
KOMMO_SUBDOMAIN=c3xsolarinvest
KOMMO_LONG_LIVED_TOKEN=

KOMMO_CONTACT_EMAIL_FIELD_ID=
KOMMO_CONTACT_PHONE_FIELD_ID=

KOMMO_LEAD_FIELD_ID_MUNICIPIO=
KOMMO_LEAD_FIELD_ID_TIPO_IMOVEL=
KOMMO_LEAD_FIELD_ID_CONSUMO_MEDIO=
KOMMO_LEAD_FIELD_ID_TIPO_SISTEMA=

# Integração server-side com a API pública de alteração de rateio
# Nunca use prefixo NEXT_PUBLIC_ nestas variáveis.
SOLARINVEST_APP_URL=https://app.solarinvest.info
SITE_PUBLIC_API_KEY=

# OPCIONAL. Cifra o retrato do projeto que o formulário devolve no envio, para o
# envio não depender de cair na mesma instância serverless da consulta. Mínimo de
# 32 caracteres. Em branco, o lacre usa SITE_PUBLIC_API_KEY com chave derivada.
RATEIO_LOOKUP_SEAL_SECRET=

# Envio das solicitações do site para o inbox operacional da SolarInvest
RESEND_API_KEY=
